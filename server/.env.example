# --- Telnyx (Portal -> Account Settings -> Keys & Credentials) ---
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=            # webhook signature verification (same page, "Public Key")
TELNYX_CONNECTION_ID=         # Call Control app id -- Claude fills after creating it via API

# --- Caller IDs, E.164. Leave INDIA blank until the +91 number clears. ---
FROM_NUMBER_INDIA=
FROM_NUMBER_EU=               # +44 -> Europe / Middle East / Africa
FROM_NUMBER_US=               # +1  -> Americas / APAC fallback

# --- Reachability ---
PUBLIC_URL=                   # https://<static>.ngrok-free.app today; Railway URL Sunday
PORT=3001
CLIENT_ORIGIN=http://localhost:3000

# --- Data / auth ---
DATABASE_URL=                 # Railway Postgres -- Claude fills after `railway login`
SESSION_SECRET=

# Plumbing test only: dial outside lead-local hours. Remove before Monday.
# IGNORE_WINDOWS=true

# --- Browser audio ---
TELNYX_WEBRTC_CONNECTION_ID=  # Credential Connection for the WebRTC softphone -- scripts/telnyx-setup.mjs fills it

# --- HubSpot inlet (docs/HUBSPOT-QUEUE.md) ---
# Private app token: Settings -> Integrations -> Private Apps -> Create. Read scopes only --
# crm.objects.contacts.read, crm.schemas.contacts.read, crm.objects.owners.read.
# Also create one contact property: eazybe_dial_queue, "Eazybe - Dial queue", single checkbox.
# Leave blank and nothing HubSpot-shaped runs; CSV upload stays the only inlet.
HUBSPOT_TOKEN=
HUBSPOT_POLL_SECONDS=60        # background reconcile; Start dialing and Up next also pull on their own
