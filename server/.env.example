# Copy to server/.env. Run npm commands from server/ or use root dev:server.
# Start the local development database with npm run dev:db from the root.
# For a full PostgreSQL server, replace DATABASE_URL with that server's URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
SESSION_SECRET=replace-with-a-random-secret
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
# Use a public HTTPS tunnel URL here for real Plivo webhooks/media.
PUBLIC_URL=http://localhost:3001

# Required for real calling; leave blank for local login/dashboard development.
# Owned Plivo caller IDs in E.164 format, for example +12025550100.
FROM_NUMBER_INDIA=
FROM_NUMBER_EU=
FROM_NUMBER_US=

# Optional HubSpot integration; blank disables polling.
HUBSPOT_TOKEN=
HUBSPOT_POLL_SECONDS=60

# Calling behavior (matches application defaults).
IGNORE_WINDOWS=false
RECORD_CALLS=true
RECORD_BEEP=false

# Plivo Console account credentials. Required for real calling.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Voice Application with POST answer URL: PUBLIC_URL/webhooks/plivo/application
PLIVO_APPLICATION_ID=

# Shared server-to-server secret; same value as CRM HANS_DIALER_QUEUE_TOKEN (32+ characters).
CRM_QUEUE_TOKEN=test@123
